# ── API Server & Security ────────────────────────────────────────────────────
# Address and port the HTTP REST and WebSocket server listens on
XLOKA__LISTEN=0.0.0.0:3000

# Admin token required to access /api/admin/* endpoints (fail-closed when unset)
XLOKA__ADMIN_TOKEN=your_super_secret_admin_token

# Optional API key for the read-only data plane (/api/v1/query/* and /api/v1/ws)
# Leave empty to keep the data plane open, or use per-account API keys (xk_...)
XLOKA__DATA_API_KEY=

# Comma-separated list of allowed CORS browser origins (empty or "*" allows all)
XLOKA__ALLOWED_DOMAINS=

# ── Storage & Paths ──────────────────────────────────────────────────────────
# Default DuckDB database file path
XLOKA__DB_PATH=xloka-flow.db

# Path to the multi-account registry file (place on a persistent volume in Docker)
XLOKA__ACCOUNTS_FILE=accounts.json

# Hot-reload poll interval in seconds for `accounts.json` (0 disables polling)
XLOKA__ACCOUNTS_RELOAD_SECS=0

# Set to true when an external control plane owns `accounts.json` (returns 409 on POST/DELETE /accounts)
XLOKA__ACCOUNTS_READ_ONLY=false

# Set to true to delete `data/<id>.db` files when an account is removed from `accounts.json`
XLOKA__ACCOUNTS_PRUNE_DATA=false

# Path to the declarative SQL query manifest
XLOKA__QUERY_MANIFEST_PATH=flow_queries.toml.example

# Optional directory containing per-account query manifests (`<dir>/<account_id>.toml`)
XLOKA__QUERY_MANIFEST_DIR=queries

# ── Performance & Limits ─────────────────────────────────────────────────────
# Per-account DuckDB memory ceiling (e.g. 256MB, 512MB, 1GB)
XLOKA__ACCOUNT_MEMORY_LIMIT=256MB

# Per-account DuckDB worker thread count
XLOKA__DUCKDB_THREADS=2

# Maximum concurrent replicated accounts on this node (0 = unlimited)
XLOKA__MAX_ACCOUNTS=16

# Number of CDC row-ops to buffer before flushing to DuckDB (default: 10000)
XLOKA__BATCH_SIZE=10000

# Max milliseconds to wait before flushing a partial batch (default: 50)
XLOKA__FLUSH_INTERVAL_MS=50

# Maximum concurrent WebSocket connections (default: 1000)
XLOKA__MAX_WS_CONNECTIONS=1000

# Maximum rows returned per analytical statement (default: 100000)
XLOKA__MAX_QUERY_ROWS=100000
