# ── API Server (SaaS Mode) ───────────────────────────────────────────────────
# Address and port the HTTP API listens on
XLOKA__LISTEN=0.0.0.0:3000

# The admin token used by the React Dashboard to manage accounts
# Required to hit /api/admin/* endpoints
XLOKA__ADMIN_TOKEN=your_super_secret_token_here

# ── Performance ───────────────────────────────────────────────────────────────
# Number of CDC row-ops to buffer before flushing to DuckDB (default: 500)
XLOKA__BATCH_SIZE=500

# Max milliseconds to wait before flushing a partial batch (default: 1000)
XLOKA__FLUSH_INTERVAL_MS=1000
